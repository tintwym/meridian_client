# Copy to `.env`:
#   cp .env.example .env

GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://127.0.0.1:3000"

# Required in production — generate: openssl rand -base64 32
# AUTH_SECRET=

# ---------------------------------------------------------------------------
# Frontend API mode (Next.js — NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_MODE=auto   # auto | mock | live
# NEXT_PUBLIC_API_BASE_URL=   # leave empty for same-origin /api

# ---------------------------------------------------------------------------
# Supabase (optional — Club + Realtime)
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Club social auth / OTP (optional)
# ---------------------------------------------------------------------------
# AUTH_SOCIAL_STUB=1
# GOOGLE_CLIENT_ID=
# RESEND_API_KEY=
# OTP_FROM_EMAIL=

# Admin API only (used when admin calls this backend)
# ADMIN_PASSWORD=
# ADMIN_INVITE_CODE=
# ADMIN_ORIGIN=http://localhost:3001

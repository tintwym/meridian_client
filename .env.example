# Copy to `.env`:
#   cp .env.example .env

GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://127.0.0.1:3000"

# Required in production — generate: openssl rand -base64 32
# AUTH_SECRET=

# ---------------------------------------------------------------------------
# Frontend API mode (Next.js — NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_MODE=auto   # auto | mock | live
# NEXT_PUBLIC_API_BASE_URL=   # leave empty for same-origin /api

# ---------------------------------------------------------------------------
# Supabase (optional — Club + Realtime)
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Club social auth / OTP
# ---------------------------------------------------------------------------
# Dev: social stub is ON by default (email-only Google/Apple for testing).
# Prod: stub is OFF unless you set AUTH_SOCIAL_STUB=1.
# AUTH_SOCIAL_STUB=0          # forbid stub even in development
# AUTH_SOCIAL_STUB=1          # allow stub in production (not recommended)
# GOOGLE_CLIENT_ID=           # verify Google idToken when set
# RESEND_API_KEY=             # send OTP emails
# OTP_FROM_EMAIL=             # e.g. Meridian <otp@yourdomain.com>
# OTP_EXPOSE_CODE=1           # return OTP in API response (dev only)
# DEMO_MODE=1                 # demo helpers if enabled in code

# ---------------------------------------------------------------------------
# Admin API (used when admin dashboard calls this backend)
# ---------------------------------------------------------------------------
# ADMIN_PASSWORD=
# ADMIN_INVITE_CODE=
# ADMIN_ORIGIN=http://localhost:3001
